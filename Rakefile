# frozen_string_literal: true

require 'rspec/core/rake_task'
require 'yard'

desc 'Install project dependencies'
task :setup do
  sh 'bundle install'
  sh 'rbs --collection .config/rbs_collection.yaml collection install'
  sh 'npm install'
end

desc 'Run linter and type checks'
task :check do
  # Metrics cops are reported but do not fail the build (severity refactor).
  # Style, Layout and Lint cops fail the build (convention and above).
  sh 'rubocop --config .config/.rubocop.yaml --fail-level convention'
  sh 'rbs-inline --output sig lib'
  sh 'rbs validate'
  sh 'steep check --steepfile .config/Steepfile'
end

RSpec::Core::RakeTask.new(:test) do |t|
  t.rspec_opts = '--options .config/.rspec'
  t.pattern = 'test/**/*.rb'
end

desc 'Generate HTML from Markdown'
task :build do
  sh 'ruby bin/convert.rb'
  sh 'npm run build'
  sh 'npm run format'
end

namespace :docs do
  YARD::Rake::YardocTask.new(:build) do |t|
    t.options = ['--yardopts', '.config/.yardopts']
  end
  task :build do
    # XXX
    sh 'ruby', '-i', '-pe', 'gsub(/Generated on .*? by/, "Generated by")', *Dir['docs/**/*.html']
  end

  desc 'Start YARD server'
  task :server do
    sh 'yard server --yardopts .config/.yardopts --reload'
  end
end
desc 'Generate documentation'
task docs: 'docs:build'

desc 'Start the preview server'
task :server do
  sh 'npm run preview -- --background'
end

task default: :setup
