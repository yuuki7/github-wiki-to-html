# frozen_string_literal: true

require 'rspec/core/rake_task'
require 'yard'

desc 'Install project dependencies'
task :setup do
  sh 'bundle install'
  sh 'rbs --collection .config/rbs_collection.yaml collection install'
  sh 'npm install'
  sh 'npm run setup:browser'
end

namespace :check do
  desc 'Run the Ruby linter and type checks'
  task :ruby do
    # Metrics cops are reported but do not fail the build (severity refactor).
    # Style, Layout and Lint cops fail the build (convention and above).
    sh 'rubocop --config .config/.rubocop.yaml --fail-level convention'
    sh 'rbs-inline --output sig lib'
    sh 'rbs --collection .config/rbs_collection.yaml -I sig validate'
    sh 'steep check --steepfile .config/Steepfile'
  end

  desc "Run the TypeScript type check, for the site's side"
  task :ts do
    sh 'npm run check'
  end
end

desc 'Run linter and type checks'
task check: ['check:ruby', 'check:ts']

RSpec::Core::RakeTask.new(:test) do |t|
  # The pattern must live here: an unset pattern makes the task inject its
  # built-in default (spec/**/*_spec.rb) ahead of anything in the options
  # file, which wins the conflict and matches nothing.
  t.pattern = 'test/**/*.rb'
  t.rspec_opts = '--options .config/.rspec'
end

namespace :test do
  desc 'Run the TypeScript unit tests'
  task :ts do
    sh 'npm run test'
  end

  desc 'Run the browser tests, against the built site'
  task :browser do
    sh 'npm run test:browser'
  end
end
Rake::Task[:test].enhance(['test:ts'])

namespace :build do
  desc 'Convert the wiki to Markdown'
  task :md do
    sh 'ruby bin/convert.rb'
  end

  desc 'Build the site from the converted Markdown'
  task :site do
    sh 'npm run build'
    sh 'npm run format'
  end
end

desc 'Generate HTML from Markdown'
task build: ['build:md', 'build:site']

namespace :docs do
  YARD::Rake::YardocTask.new(:build) do |t|
    t.options = ['--yardopts', '.config/.yardopts']
  end
  task :build do
    # XXX: an ad-hoc hack. YARD stamps the build date into every
    # generated page. Without this, every page would change on
    # every build, even when nothing else changed.
    sh 'ruby', '-i', '-pe', 'gsub(/Generated on .*? by/, "Generated by")', *Dir['docs/**/*.html']
  end

  desc 'Start YARD server'
  task :server do
    sh 'yard server --yardopts .config/.yardopts --reload'
  end
end
desc 'Generate documentation'
task docs: 'docs:build'

desc 'Start the preview server'
task :server do
  sh 'npm run preview'
end

task default: :setup
