---
import Base from "./Base.astro";
import { absoluteUrl } from "../i18n";
import type { RedirectProps } from "../types";

type Props = RedirectProps;

const { title, language = "en", className, targetHref } = Astro.props;
const target = targetHref;
---

<Base
  title={title}
  language={language}
  className={className}
  canonical={absoluteUrl(targetHref)}
>
  <Fragment slot="head">
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </Fragment>

  <p>
    <a href={target}>Redirect</a>
  </p>
</Base>
