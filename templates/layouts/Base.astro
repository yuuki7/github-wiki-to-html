---
import BaseHead from "../components/BaseHead.astro";
import { directionFor } from "../i18n";
import type { ArticleMetaProps, BaseProps } from "../types";

import "../styles/page.css";

type Props = BaseProps & {
  meta?: ArticleMetaProps;
  isHome?: boolean;
};

const {
  title,
  language,
  className,
  alternates,
  canonical,
  ogType,
  meta,
  isHome,
} = Astro.props;
---

<!doctype html>
<html lang={language} dir={directionFor(language)}>
  <head prefix="og: https://ogp.me/ns#">
    <BaseHead
      title={title}
      language={language}
      alternates={alternates}
      canonical={canonical}
      ogType={ogType}
      meta={meta}
      isHome={isHome}
    />
    <slot name="head" />
    <script is:inline defer src="/site.js"></script>
    <script is:inline defer src="/ai-assistant.js"></script>
    <script is:inline defer src="/assets/js/mathjax-config.js"></script>
    <script
      is:inline
      defer
      src="https://cdn.jsdelivr.net/npm/mathjax@4.1.2/startup.js"
      integrity="sha512-hWGDmsdTVDhEQ++tRfdduyZoXByJaAEMAGK3i/5dphjQrNplBhzLYHQIwR3ZqXH74uE1y5DNFpGNXQqWYhiUOQ=="
      crossorigin="anonymous"
    ></script>
  </head>
  <body class={className}>
    <slot />
  </body>
</html>
