---
import BaseHead from "../components/BaseHead.astro";
import { directionFor } from "../i18n";
import type { BaseProps } from "../types";

import "../styles/page.css";

type Props = BaseProps;

const { title, language, className, alternates } = Astro.props;
---

<!doctype html>
<html lang={language} dir={directionFor(language)}>
  <head>
    <BaseHead title={title} alternates={alternates} />
    <slot name="head" />
    <script is:inline defer src="/site.js"></script>
    <script is:inline defer src="/assets/js/mathjax-config.js"></script>
    <script
      is:inline
      defer
      src="https://cdn.jsdelivr.net/npm/mathjax@4.1.2/startup.js"
      integrity="sha512-hWGDmsdTVDhEQ++tRfdduyZoXByJaAEMAGK3i/5dphjQrNplBhzLYHQIwR3ZqXH74uE1y5DNFpGNXQqWYhiUOQ=="
      crossorigin="anonymous"
    ></script>
  </head>
  <body class={className}>
    <slot />
  </body>
</html>
