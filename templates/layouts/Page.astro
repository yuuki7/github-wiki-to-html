---
import Base from "./Base.astro";
import Header from "../components/Header.astro";
import site from "../../site.json";
import LeftSidebar from "../components/LeftSidebar.astro";
import Main from "../components/Main.astro";
import RightSidebar from "../components/RightSidebar.astro";
import Footer from "../components/Footer.astro";
import type { ArticleProps } from "../types";

type Props = ArticleProps;

const { title, isHome, meta, language, className } = Astro.props;
---

<Base title={title} language={language} className={className}>
  <Header>
    <nav>
      <a href="/">{site.name}</a>
    </nav>
  </Header>

  <LeftSidebar>
    <slot name="left-sidebar" />
  </LeftSidebar>

  <Main title={title} isHome={isHome} meta={meta}>
    <slot />
  </Main>

  <RightSidebar>
    {Astro.slots.has("right-sidebar") ? (
      <slot name="right-sidebar" />
    ) : (
      <p>aaa</p>
    )}
  </RightSidebar>

  <Footer>
    <slot name="footer" />
  </Footer>
</Base>
