---
import Base from "./Base.astro";
import Header from "../components/Header.astro";
import site from "../../site.json";
import LeftSidebar from "../components/LeftSidebar.astro";
import Main from "../components/Main.astro";
import RightSidebar from "../components/RightSidebar.astro";
import Footer from "../components/Footer.astro";
import { homeHref, languageName } from "../i18n";
import type { ArticleProps } from "../types";

type Props = ArticleProps;

const {
  title,
  isHome,
  meta,
  language,
  className,
  languageLinks,
  canonical,
  ogType,
} = Astro.props;
---

<Base
  title={title}
  language={language}
  className={className}
  alternates={languageLinks}
  canonical={canonical}
  ogType={ogType}
  meta={meta}
  isHome={isHome}
>
  <slot name="head" slot="head" />

  <Header>
    <nav>
      {!isHome && <a href={homeHref(language)}>{site.name}</a>}
      {languageLinks && languageLinks.length > 1 && (
        <div class="language-menu">
          <button
            type="button"
            class="language-menu__button"
            popovertarget="language-switcher"
          >
            <span aria-hidden="true">🌐</span>
            {languageName(language)}
          </button>
          <ul class="language-menu__panel" id="language-switcher" popover>
            {languageLinks.map((link) => (
              <li>
                {link.language === language ? (
                  <span
                    aria-current="true"
                    set:text={languageName(link.language)}
                  />
                ) : (
                  <a
                    href={link.href}
                    hreflang={link.language}
                    lang={link.language}
                    set:text={languageName(link.language)}
                  />
                )}
              </li>
            ))}
          </ul>
        </div>
      )}
    </nav>
  </Header>

  <LeftSidebar>
    <slot name="left-sidebar" />
  </LeftSidebar>

  <Main title={title} isHome={isHome} meta={meta} language={language}>
    <slot />
  </Main>

  <RightSidebar>
    <slot name="right-sidebar" />
  </RightSidebar>

  <Footer>
    <slot name="footer" />
  </Footer>
</Base>
