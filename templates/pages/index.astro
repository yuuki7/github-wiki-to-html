---
import HomePage from "../layouts/HomePage.astro";
import allPages from "../../all-pages.json";
import site from "../../site.json";

const recentlyCreatedPages = allPages
  .filter((page) => page.listed)
  .sort((a, b) => {
    return (
      Temporal.Instant.from(b.creation_date).epochMilliseconds -
      Temporal.Instant.from(a.creation_date).epochMilliseconds
    );
  });
---

<HomePage className="home" title={site.name} language={site.language} isHome>
  <ul slot="left-sidebar">
    {recentlyCreatedPages.map((page) => (
      <li>
        <a href={`/${encodeURIComponent(page.slug)}`}>{page.title}</a>
      </li>
    ))}
  </ul>

  <Fragment set:html={site.home} />

  <Fragment slot="footer" set:html={site.footer} />
</HomePage>
