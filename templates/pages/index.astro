---
import { getCollection, render } from "astro:content";
import HomePage from "../layouts/HomePage.astro";
import site from "../../site.json";

const pages = await getCollection("pages");

const home = pages.find(
  (f) => f.data.kind === "special" && f.data.slug === "Home",
);
const footer = pages.find(
  (f) => f.data.kind === "special" && f.data.slug === "_Footer",
);
if (!home || !footer) {
  throw new Error("Home or footer page is missing");
}

const listedPages = pages
  .filter((p) => p.data.kind === "article" && (p.data.listed ?? true))
  .sort((a, b) => b.data.creation_date.localeCompare(a.data.creation_date));

const { Content: HomeContent } = await render(home);
const { Content: FooterContent } = await render(footer);
---

<HomePage
  className="home"
  title={site.name}
  language={home.data.language}
  isHome
>
  <ul slot="left-sidebar">
    {listedPages.map((entry) => (
      <li>
        <a href={`/${encodeURIComponent(entry.data.slug)}`}>
          {entry.data.title}
        </a>
      </li>
    ))}
  </ul>

  <HomeContent />

  <Fragment slot="footer">
    <FooterContent />
  </Fragment>
</HomePage>
