---
import Page from "../layouts/Page.astro";
import RedirectPage from "../components/RedirectPage.astro";
import allPages from "../../all-pages.json";
import site from "../../site.json";

export async function getStaticPaths() {
  return allPages.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
---

{item.redirect ? (
  <RedirectPage title={item.title} targetSlug={item.target_slug} />
) : (
  <Page
    className="individual"
    title={item.title}
    language={item.language}
    meta={{
      author: item.author,
      creationDate: item.creation_date,
      modifiedDate: item.modified_date,
    }}
  >
    <Fragment slot="header">
      <nav>
        <a href="/">{site.name}</a>
      </nav>
    </Fragment>

    <Fragment slot="left-sidebar" set:html={item.toc} />

    <Fragment set:html={item.html} />

    <Fragment slot="footer">
      <Fragment set:html={site.footer} />
      <a href={item.url_on_wiki}>Edit this page on GitHub Wiki</a>
    </Fragment>
  </Page>
)}
