---
import { getCollection, render } from "astro:content";
import IndividualPage from "../layouts/IndividualPage.astro";
import site from "../../site.json";
import Redirect from "../layouts/Redirect.astro";
import Toc from "../components/Toc.astro";

export async function getStaticPaths() {
  const entries = await getCollection("pages");
  return entries
    .filter(
      (entry) =>
        entry.data.kind === "article" || entry.data.kind === "redirect",
    )
    .map((entry) => ({
      params: { slug: entry.data.slug },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const isRedirect = entry.data.kind === "redirect";

const entries = await getCollection("pages");
const footerFragment = entries.find(
  (f) => f.data.kind === "special" && f.data.slug === "_Footer",
);
const { Content: FooterContent } = footerFragment
  ? await render(footerFragment)
  : { Content: null };

const rendered = isRedirect ? null : await render(entry);
---

{isRedirect ? (
  <Redirect title={entry.data.title} targetSlug={entry.data.target_slug} />
) : (
  <IndividualPage
    title={entry.data.title}
    language={entry.data.language}
    meta={{
      author: entry.data.author,
      creationDate: entry.data.creation_date,
      modifiedDate: entry.data.modified_date,
    }}
  >
    <Fragment slot="left-sidebar">
      <Toc headings={rendered.headings} />
    </Fragment>

    <rendered.Content />

    <Fragment slot="footer">
      {FooterContent && <FooterContent />}
      <a href={`${site.wiki_url}/${encodeURIComponent(entry.data.slug)}`}>
        Edit this page on GitHub Wiki
      </a>
    </Fragment>
  </IndividualPage>
)}
