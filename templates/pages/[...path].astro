---
import { getCollection } from "astro:content";
import ArticleView from "../components/ArticleView.astro";

export async function getStaticPaths() {
  const entries = await getCollection("pages");

  // A redirect carries no language of its own; the language it
  // serves is the directory its file lives in.
  const directoryLanguage = (entry: {
    filePath?: string;
    id: string;
  }): string => {
    const parts = (entry.filePath ?? entry.id).split("/");
    return parts[parts.length - 2];
  };
  const originalOf = (slug: string) =>
    entries.find(
      (e) =>
        e.data.kind === "article" &&
        e.data.slug === slug &&
        !e.data.translation,
    );

  return entries
    .filter(
      (entry) =>
        entry.data.kind === "article" || entry.data.kind === "redirect",
    )
    .map((entry) => {
      if (entry.data.kind === "article") {
        // An original lives at the root; a translation lives under
        // its language.
        const path = entry.data.translation
          ? `${entry.data.language}/${entry.data.slug}`
          : entry.data.slug;
        return {
          params: { path },
          props: { entry, lang: entry.data.language },
        };
      }
      // A redirect is served at the root in its target's original
      // language, and under its directory's language elsewhere.
      const lang = directoryLanguage(entry);
      const original = originalOf(entry.data.target_slug);
      const path =
        original && original.data.language === lang
          ? entry.data.slug
          : `${lang}/${entry.data.slug}`;
      return { params: { path }, props: { entry, lang } };
    });
}

const { entry, lang } = Astro.props;
---

<ArticleView entry={entry} lang={lang} />
