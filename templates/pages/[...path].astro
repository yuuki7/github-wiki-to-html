---
import { getCollection } from "astro:content";
import ArticleView from "../components/ArticleView.astro";
import Redirect from "../layouts/Redirect.astro";
import { defaultLanguage, missingVersions, pageHref } from "../i18n";
import site from "../../site.json";

export async function getStaticPaths() {
  const entries = await getCollection("pages");

  // Pages link to every language's version unconditionally, so a
  // missing version would leave dead links. Refuse to build until
  // every version exists.
  const missing = missingVersions(entries);
  if (missing.length > 0) {
    throw new Error(`missing translations: ${missing.join(", ")}`);
  }

  // A redirect carries no language of its own; the language it
  // serves is the directory its file lives in.
  const directoryLanguage = (entry: {
    filePath?: string;
    id: string;
  }): string => {
    const parts = (entry.filePath ?? entry.id).split("/");
    return parts[parts.length - 2];
  };
  const originalOf = (slug: string) =>
    entries.find(
      (e) =>
        e.data.kind === "article" &&
        e.data.slug === slug &&
        !e.data.translation,
    );

  const paths = [];

  for (const entry of entries) {
    if (entry.data.kind === "article") {
      if (entry.data.translation) {
        // A translation lives under its language.
        paths.push({
          params: { path: `${entry.data.language}/${entry.data.slug}` },
          props: { entry, lang: entry.data.language },
        });
      } else {
        // An original lives at the root. The same article addressed
        // with its original language's code redirects to the
        // code-less URL.
        paths.push({
          params: { path: entry.data.slug },
          props: { entry, lang: entry.data.language },
        });
        paths.push({
          params: { path: `${entry.data.language}/${entry.data.slug}` },
          props: {
            title: entry.data.title,
            redirectTo: pageHref(entry.data.language, entry.data.slug),
          },
        });
      }
    } else if (entry.data.kind === "redirect") {
      // A redirect is served at the root in its target's original
      // language, and under its directory's language elsewhere.
      const lang = directoryLanguage(entry);
      const original = originalOf(entry.data.target_slug);
      if (original && original.data.language === lang) {
        paths.push({
          params: { path: entry.data.slug },
          props: { entry, lang },
        });
        // The alias addressed with its language's code redirects
        // to the code-less alias.
        paths.push({
          params: { path: `${lang}/${entry.data.slug}` },
          props: { title: entry.data.title, redirectTo: `/${entry.data.slug}` },
        });
      } else {
        paths.push({
          params: { path: `${lang}/${entry.data.slug}` },
          props: { entry, lang },
        });
      }
    }
  }

  // The default language's home lives at the root. Addressed with
  // its code, it redirects there.
  paths.push({
    params: { path: defaultLanguage },
    props: { title: site.title, redirectTo: "/" },
  });

  return paths;
}

const { entry, lang, title, redirectTo } = Astro.props;
---

{redirectTo ? (
  <Redirect title={title} targetHref={redirectTo} />
) : (
  <ArticleView entry={entry} lang={lang} />
)}
