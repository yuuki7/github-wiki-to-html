---
import HomeView from "../../components/HomeView.astro";
import { defaultLanguage, supportedLanguages } from "../../i18n";

export function getStaticPaths() {
  // Every language the site declares gets a home page, whether or
  // not it has any page yet. The list comes from site.json (via
  // i18n's supportedLanguages), never from the content itself.
  // The default language's home is the site root instead (see
  // pages/index.astro), so it is not generated here.
  return supportedLanguages
    .filter((lang) => lang !== defaultLanguage)
    .map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props;
---

<HomeView lang={lang} />
