---
import { getCollection, render } from "astro:content";
import HomePage from "../../layouts/HomePage.astro";
import site from "../../../site.json";
import { homeHref, pageHref } from "../../i18n";

export async function getStaticPaths() {
  // A language gets a home page when it has any page of its own:
  // an article written in it, a translation into it, or its Home.
  const pages = await getCollection("pages");
  const languages = new Set<string>();
  for (const page of pages) {
    if (page.data.kind === "article" || page.data.kind === "special") {
      languages.add(page.data.language);
    }
  }
  return [...languages].map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props;
const pages = await getCollection("pages");

const home = pages.find(
  (f) =>
    f.data.kind === "special" &&
    f.data.slug === "Home" &&
    f.data.language === lang,
);
const footer =
  pages.find(
    (f) =>
      f.data.kind === "special" &&
      f.data.slug === "_Footer" &&
      f.data.language === lang,
  ) ??
  pages.find(
    (f) =>
      f.data.kind === "special" &&
      f.data.slug === "_Footer" &&
      f.data.language === site.language,
  );

const listedPages = pages
  .filter(
    (p) =>
      p.data.kind === "article" &&
      p.data.language === lang &&
      (p.data.listed ?? true),
  )
  .sort((a, b) => b.data.creation_date.localeCompare(a.data.creation_date));

// The other languages' home pages, for the switcher and hreflang.
const homeLanguages = [
  ...new Set(
    pages
      .filter((p) => p.data.kind === "article" || p.data.kind === "special")
      .map((p) => p.data.language),
  ),
];
const languageLinks = homeLanguages.map((language) => ({
  language,
  href: homeHref(language),
}));

const { Content: HomeContent } = home ? await render(home) : { Content: null };
const { Content: FooterContent } = footer
  ? await render(footer)
  : { Content: null };
---

<HomePage
  className="home"
  title={site.name}
  language={lang}
  isHome
  alternates={languageLinks}
  languageLinks={languageLinks}
>
  <Fragment slot="head">
    <link rel="alternate" hreflang="x-default" href={homeHref(site.language)} />
  </Fragment>

  <ul slot="left-sidebar">
    {listedPages.map((entry) => (
      <li>
        <a href={pageHref(lang, entry.data.slug)}>{entry.data.title}</a>
      </li>
    ))}
  </ul>

  {HomeContent && <HomeContent />}

  <Fragment slot="footer">{FooterContent && <FooterContent />}</Fragment>
</HomePage>
