---
import site from "../../site.json";
import { absoluteUrl } from "../i18n";
import type { AlternateLink, ArticleMetaProps } from "../types";

type Props = {
  title: string;
  language: string;
  alternates?: AlternateLink[];
  canonical?: string;
  ogType?: "article" | "website";
  meta?: ArticleMetaProps;
  isHome?: boolean;
};

const { title, language, alternates, canonical, ogType, meta, isHome } =
  Astro.props;

const iconUrl = absoluteUrl("/assets/images/icon.jpg");
const licenseUrl = "https://creativecommons.org/licenses/by/4.0/";

// The organization behind the site, as the previous site's
// structured data declared it.
const organization = {
  "@type": "Organization",
  name: site.name,
  url: absoluteUrl("/"),
  logo: iconUrl,
};

// The site's structured data, in the shape the previous site
// declared.
const websiteData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.name,
  url: canonical,
  image: iconUrl,
  license: licenseUrl,
  author: organization,
  publisher: organization,
};

// An article's structured data: its author and dates, with the
// same publisher and license as the site's.
const articleData =
  ogType === "article" && meta
    ? {
        "@context": "https://schema.org",
        "@type": "Article",
        headline: title,
        inLanguage: language,
        mainEntityOfPage: canonical,
        license: licenseUrl,
        author: { "@type": "Person", name: meta.author },
        datePublished: meta.creationDate,
        ...(meta.modifiedDate ? { dateModified: meta.modifiedDate } : {}),
        publisher: organization,
      }
    : undefined;

// JSON for a script block: a literal "<" in a string (a page
// title, an author name) could close the block early, so it
// is escaped; JSON parsers read the escape as the same string.
const jsonLd = (data: unknown): string =>
  JSON.stringify(data, null, 2).replaceAll("<", "\\u003c");
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="color-scheme" content="light dark" />
<meta name="format-detection" content="telephone=no" />
<title>{title}</title>
{canonical && <link rel="canonical" href={canonical} />}
<link rel="icon" type="image/jpeg" href="/assets/images/icon.jpg" />
<link rel="license" href={licenseUrl} />
<meta name="author" content={meta?.author ?? site.name} />
{alternates?.map((alternate) => (
  <link
    rel="alternate"
    hreflang={alternate.language}
    href={absoluteUrl(alternate.href)}
  />
))}
{ogType && canonical && (
  <Fragment>
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={iconUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={site.name} />
    <meta property="og:site_name" content={site.name} />
    {ogType === "article" && meta && (
      <Fragment>
        <meta property="article:published_time" content={meta.creationDate} />
        {meta.modifiedDate && (
          <meta property="article:modified_time" content={meta.modifiedDate} />
        )}
        <meta property="article:author" content={meta.author} />
      </Fragment>
    )}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content={iconUrl} />
  </Fragment>
)}
{isHome && <script type="application/ld+json" set:html={jsonLd(websiteData)} />}
{articleData && (
  <script type="application/ld+json" set:html={jsonLd(articleData)} />
)}
