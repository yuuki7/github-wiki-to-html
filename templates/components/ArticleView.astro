---
import { getCollection, render } from "astro:content";
import Page from "../layouts/Page.astro";
import site from "../../site.json";
import Redirect from "../layouts/Redirect.astro";
import AiAssistant from "./AiAssistant.astro";
import Toc from "./Toc.astro";
import { articlePageData, specialPage } from "../content";
import {
  absoluteUrl,
  defaultLanguage,
  languageNameInNominative,
  pageHref,
  uiFor,
} from "../i18n";

// One article page, or one redirect stub. `lang` is the language
// the page is served for: the article's own language, or, for a
// redirect (which carries no language), its directory's language.
const { entry, lang } = Astro.props;

const entries = await getCollection("pages");
const {
  isRedirect,
  originalLanguage,
  articleLinks,
  targetHref,
  isTranslation,
} = articlePageData(entry, entries, lang);

// The footer in this page's language, falling back to the site's
// default language when the footer has not been translated.
const footerFragment = specialPage(entries, "_Footer", lang, defaultLanguage);
const { Content: FooterContent } = footerFragment
  ? await render(footerFragment)
  : { Content: null };

const ui = uiFor(lang);

const rendered = isRedirect ? null : await render(entry);
---

{isRedirect ? (
  <Redirect title={entry.data.title} language={lang} targetHref={targetHref!} />
) : (
  <Page
    title={entry.data.title}
    language={entry.data.language}
    languageLinks={articleLinks}
    canonical={absoluteUrl(
      pageHref(lang, entry.data.slug, entry.data.translation ?? false),
    )}
    ogType="article"
    meta={{
      author: entry.data.author,
      creationDate: entry.data.creation_date,
      modifiedDate: entry.data.modified_date,
      language: entry.data.language,
      ...(isTranslation
        ? {
            translation: {
              originalLanguage: originalLanguage ?? lang,
              originalHref: pageHref(originalLanguage ?? lang, entry.data.slug),
            },
          }
        : {}),
    }}
  >
    <Fragment slot="head">
      {originalLanguage && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={absoluteUrl(pageHref(originalLanguage, entry.data.slug))}
        />
      )}
    </Fragment>

    <Fragment slot="left-sidebar">
      {rendered && <Toc headings={rendered.headings} />}
    </Fragment>

    <Fragment slot="right-sidebar">
      <AiAssistant ui={ui} />
    </Fragment>

    {rendered && <rendered.Content />}

    <Fragment slot="footer">
      {FooterContent && <FooterContent />}
      <a href={`${site.wiki_url}/${encodeURIComponent(entry.data.slug)}`}>
        {isTranslation
          ? ui.editPageFrom(
              languageNameInNominative(lang, originalLanguage ?? lang),
            )
          : ui.editPage}
      </a>
    </Fragment>
  </Page>
)}
