---
import { getCollection, render } from "astro:content";
import Page from "../layouts/Page.astro";
import AiAssistant from "./AiAssistant.astro";
import { specialPage } from "../content";
import type { ArticleEntry } from "../types";
import site from "../../site.json";
import {
  absoluteUrl,
  defaultLanguage,
  homeHref,
  languageNameInNominative,
  pageHref,
  supportedLanguages,
  uiFor,
} from "../i18n";

// One language's home page, listing that language's articles.
const { lang } = Astro.props;
const pages = await getCollection("pages");

const home = pages.find(
  (f) =>
    f.data.kind === "special" &&
    f.data.slug === "Home" &&
    f.data.language === lang,
);
const footer = specialPage(pages, "_Footer", lang, defaultLanguage);

const listedPages = pages
  .filter(
    (p): p is ArticleEntry =>
      p.data.kind === "article" &&
      p.data.language === lang &&
      (p.data.listed ?? true),
  )
  .sort((a, b) => b.data.creation_date.localeCompare(a.data.creation_date));

// The other languages' home pages, for the switcher and hreflang:
// the site's declared languages, in site.json order.
const homeLanguages = supportedLanguages;
const languageLinks = homeLanguages.map((language) => ({
  language,
  href: homeHref(language),
}));

const ui = uiFor(lang);

const { Content: HomeContent } = home ? await render(home) : { Content: null };
const { Content: FooterContent } = footer
  ? await render(footer)
  : { Content: null };
---

<Page
  className="home"
  title={site.name}
  language={lang}
  isHome
  languageLinks={languageLinks}
  canonical={absoluteUrl(homeHref(lang))}
  ogType="website"
>
  <Fragment slot="head">
    <link
      rel="alternate"
      hreflang="x-default"
      href={absoluteUrl(homeHref(site.language))}
    />
  </Fragment>

  <ul slot="left-sidebar">
    {listedPages.map((entry) => (
      <li>
        <a
          href={pageHref(
            lang,
            entry.data.slug,
            entry.data.translation ?? false,
          )}
        >
          {entry.data.title}
        </a>
      </li>
    ))}
  </ul>

  <Fragment slot="right-sidebar">
    <AiAssistant ui={ui} />
  </Fragment>

  {HomeContent && <HomeContent />}

  <Fragment slot="footer">
    {FooterContent && <FooterContent />}
    <a href={`${site.wiki_url}/${encodeURIComponent("Home")}`}>
      {lang === defaultLanguage
        ? ui.editPage
        : ui.editPageFrom(languageNameInNominative(lang, defaultLanguage))}
    </a>
  </Fragment>
</Page>
