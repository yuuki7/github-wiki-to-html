---
import { defaultLanguage, languageNameIn, uiFor } from "../i18n";
import type { ArticleMetaProps } from "../types";

interface Props extends ArticleMetaProps {}

const { author, creationDate, modifiedDate, language, translation } =
  Astro.props;
const locale = language ?? defaultLanguage;

const dateFmt = new Intl.DateTimeFormat(locale, {
  timeZone: "UTC",
  year: "numeric",
  month: "long",
  day: "numeric",
});
const timeFmt = new Intl.DateTimeFormat(locale, {
  timeZone: "UTC",
  hour: "numeric",
  minute: "2-digit",
  hour12: true,
});

// A date is shown as the date alone, with its timezone. The full
// form is the short form with the time inserted before the
// timezone, so a <details> disclosure presents it in place: the
// summary carries the date, the disclosed content is the time,
// and the timezone follows the element. The one exception is an
// article created and last modified on the same day: the two
// dates would read identically, so both carry their time from
// the start and there is nothing to disclose.
const utcDay = (iso: string) => {
  const d = new Date(iso);
  return `${d.getUTCFullYear()}-${d.getUTCMonth()}-${d.getUTCDate()}`;
};
const showModified =
  modifiedDate !== undefined && modifiedDate !== creationDate;
const sameDay = showModified && utcDay(modifiedDate) === utcDay(creationDate);
const formatDate = (iso: string) => dateFmt.format(new Date(iso));
const formatTime = (iso: string) => timeFmt.format(new Date(iso));
const formatFull = (iso: string) => `${formatDate(iso)} ${formatTime(iso)} UTC`;
---

<div class="article__meta">
  <span class="article__author">
    {uiFor(locale).byline} {author}
  </span>
  {" · "}
  {sameDay ? (
    <time
      class="article__date article__date--created"
      datetime={creationDate}
      title={creationDate}
    >
      {formatFull(creationDate)}
    </time>
  ) : (
    <>
      <details class="article__date-details">
        <summary>
          <time
            class="article__date article__date--created"
            datetime={creationDate}
            title={creationDate}
          >
            {formatDate(creationDate)}
          </time>
        </summary>
        <span class="article__date-time">{formatTime(creationDate)}</span>
      </details>
      {" UTC"}
    </>
  )}
  {showModified &&
    (sameDay ? (
      <>
        {" · "}
        <time
          class="article__date article__date--modified"
          datetime={modifiedDate}
          title={modifiedDate}
        >
          {formatFull(modifiedDate)}
        </time>
      </>
    ) : (
      <>
        {" · "}
        <details class="article__date-details">
          <summary>
            <time
              class="article__date article__date--modified"
              datetime={modifiedDate}
              title={modifiedDate}
            >
              {formatDate(modifiedDate)}
            </time>
          </summary>
          <span class="article__date-time">{formatTime(modifiedDate)}</span>
        </details>
        {" UTC"}
      </>
    ))}
</div>

{translation && (
  <p class="article__meta article__meta--translation">
    {uiFor(locale).translationNotice(
      languageNameIn(locale, translation.originalLanguage),
    )}{" "}
    <a href={translation.originalHref}>{uiFor(locale).originalArticle}</a>
  </p>
)}
