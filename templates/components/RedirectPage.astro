---
type Props = {
  title: string;
  targetSlug: string;
};

const { title, targetSlug } = Astro.props;
const target = `/${encodeURIComponent(targetSlug)}`;
---

<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <title>{title}</title>
  </head>
  <body>
    <p>
      <a href={target}>Redirect</a>
    </p>
  </body>
</html>
