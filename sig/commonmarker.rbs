module Commonmarker
  class Node
    def type: () -> Symbol
    def each: () { (Node) -> void } -> untyped
    def walk: () { (Node) -> void } -> untyped
    def string_content: () -> String
    def literal: () -> String
    def source_position: () -> Hash[Symbol, Integer]
  end

  def self.parse: (String, options: untyped) -> Node
  def self.to_html: (String, options: untyped) -> String
end
