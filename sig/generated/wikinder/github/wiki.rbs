        def self.members: () -> [ :slug, :title, :author, :creation_date, :modified_date, :language, :aliases ]

        def members: () -> [ :slug, :title, :author, :creation_date, :modified_date, :language, :aliases ]
      end

      # An original page: its file path and its own language.
      class OriginalPage < Data
        attr_reader page(): String

        attr_reader language(): String

        def self.new: (String page, String language) -> instance
                    | (page: String, language: String) -> instance

        def self.members: () -> [ :page, :language ]

        def members: () -> [ :page, :language ]
      end

      # One translation file, as read from the translations
