module Rugged
  type actor = {
    name: String,
    email: String,
    time: Time
  }

  type tree_entry = {
    name: String,
    oid: String,
    filemode: Integer,
    type: Symbol
  }

  type delta_file = {
    oid: String,
    path: String,
    size: Integer,
    flags: Integer,
    mode: Integer
  }

  class Repository
    def initialize: (String) -> void
    def head: () -> Ref
    def lookup: (String) -> Blob
    def walk: (String, ?Symbol) -> Enumerator[Commit, void]
    def rev_parse: (String) -> Commit
  end

  class Error < StandardError
  end

  class ReferenceError < Error
  end

  class Blob
    def content: () -> String
    def oid: () -> String
  end

  class Tree
    def []: (String) -> tree_entry?
    def walk: (Symbol) { (String, tree_entry) -> void } -> void
  end

  class Diff
    def deltas: () -> Array[Delta]
    def find_similar!: (?Hash[Symbol, bool]) -> Diff

    class Delta
      def old_file: () -> delta_file
      def new_file: () -> delta_file
      def status: () -> Symbol
    end
  end

  class Commit
    def tree: () -> Tree
    def id: () -> String
    def time: () -> Time
    def author: () -> actor
    def parents: () -> Array[Commit]
    def diff: (Commit?) -> Diff
  end

  class Ref
    def target: () -> Commit
    def target_id: () -> String
  end
end
