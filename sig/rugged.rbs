module Rugged
  type actor = {
    name: String,
    email: String,
    time: Time
  }

  type tree_entry = {
    name: String,
    oid: String,
    filemode: Integer,
    type: Symbol
  }

  type delta_file = {
    oid: String,
    path: String?,
    size: Integer,
    flags: Integer,
    mode: Integer
  }

  type find_similar_options = {
    ?renames: bool,
    ?renames_from_rewrites: bool,
    ?copies: bool,
    ?copies_from_unmodified: bool,
    ?break_rewrites: bool,
    ?all: bool,
    ?ignore_whitespace: bool,
    ?dont_ignore_whitespace: bool,
    ?rename_threshold: Integer,
    ?rename_from_rewrite_threshold: Integer,
    ?copy_threshold: Integer,
    ?break_rewrite_threshold: Integer,
    ?rename_limit: Integer
  }

  # The common base class of Blob, Tree and Commit: lookup,
  # rev_parse and Ref#target return whichever object the oid,
  # spec or ref names.
  class Object
  end

  class Repository
    def initialize: (String) -> void
    def head: () -> Ref
    def lookup: (String) -> Object
    def walk: (String, ?Integer) -> Enumerator[Commit, void]
    def rev_parse: (String) -> Object
  end

  class Error < StandardError
  end

  class ReferenceError < Error
  end

  class Blob < Object
    def content: () -> String
    def oid: () -> String
  end

  class Tree < Object
    def []: (String) -> tree_entry?
    def walk: (Symbol) { (String, tree_entry) -> void } -> void
  end

  class Diff
    def deltas: () -> Array[Delta]
    def find_similar!: (?find_similar_options) -> Diff

    class Delta
      def old_file: () -> delta_file
      def new_file: () -> delta_file
      def status: () -> Symbol
    end
  end

  class Commit < Object
    def tree: () -> Tree
    def id: () -> String
    def time: () -> Time
    def author: () -> actor
    def parents: () -> Array[Commit]
    def diff: (Commit?) -> Diff
  end

  class Ref
    def target: () -> Object
    def target_id: () -> String
  end
end
