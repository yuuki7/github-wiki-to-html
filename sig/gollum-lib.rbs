type gollum_wiki_options = {
  ?allow_editing: bool,
  ?base_path: String,
  ?filter_chain: Array[Symbol],
  ?hyphened_tag_lookup: bool,
  ?universal_toc: bool
}

module Gollum
  class BlobEntry
    def path: () -> String
    def sha: () -> String
  end

  class Page
    def filename_stripped: () -> String
    def footer: () -> Page?
    def format: () -> Symbol
    def formatted_data: () -> String
    def path: () -> String
    def text_data: () -> String
    def title: () -> String
    def toc_data: () -> String
    def versions: (?Hash[Symbol, untyped]) -> Array[Version]
  end

  class Version
    def author: () -> Git::Actor
    def authored_date: () -> Time
    def tracked_pathname: () -> String?
  end

  class Filter
    class Tags
      def process_tag: (String) -> String
      def open_pattern: () -> String
      def close_pattern: () -> String
      def register_tag: (String) -> String
      def initialize: (Markup) -> void
      private
      def path_to_link_text: (String) -> String
      def generate_href_for_path: (String, ?String?) -> String
      def css_options_for_link: (Symbol) -> String?
      def generate_image_attributes: (untyped?) -> [untyped, untyped, bool]
    end
  end

  module Git
    class Actor
      def name: () -> String
    end

    class Commit
      def commit: () -> untyped
      def id: () -> String
    end

    class Ref
      def commit: () -> Commit
    end

    class Repo
      def commit: (String) -> Commit?
      def head: () -> Ref
    end
  end

  class Markup
    def self.register: (Symbol, String, ?extensions: Array[String], ?render: Proc) -> void
  end

  class Wiki
    attr_reader repo: Git::Repo
    attr_reader ref: String
    def initialize: (String, ?gollum_wiki_options) -> void
    def commit_for: (String) -> Git::Commit?
    def page: (String) -> Page?
    def pages: () -> Array[Page]
    def tree_map_for: (String, ?bool) -> Array[BlobEntry]
  end
end
