{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "article"
        },
        "title": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "creation_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "modified_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "language": {
          "type": "string"
        },
        "original_language": {
          "type": "string"
        },
        "translation": {
          "default": false,
          "type": "boolean"
        },
        "listed": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "title",
        "slug",
        "author",
        "creation_date",
        "modified_date",
        "language"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "redirect"
        },
        "title": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "target_slug": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "title",
        "slug",
        "target_slug"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "special"
        },
        "title": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "language": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "title",
        "slug"
      ]
    }
  ]
}