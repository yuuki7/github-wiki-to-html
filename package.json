{
  "name": "github-wiki-to-html",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.scripts.json && astro build --config .config/astro.config.ts --silent",
    "format": "prettier --config .config/.prettierrc --ignore-path .config/.prettierignore --log-level warn --write \"templates/**/*.{astro,css,js,ts}\" \"dist/**/*.{html,js}\"",
    "check": "astro check --config .config/astro.config.ts",
    "preview": "astro preview --config .config/astro.config.ts --host 127.0.0.1"
  },
  "dependencies": {
    "hastscript": "^9.0.3",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-satteri": "^0.4.7",
    "@mlc-ai/web-llm": "0.2.88",
    "astro": "^7.4.2",
    "astro-expressive-code": "^0.44.3",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "satteri": "^0.11.6",
    "shiki": "^4.6.0",
    "typescript": "^6.0.3"
  }
}
