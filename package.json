{
  "scripts": {
    "build": "tsc --project tsconfig.scripts.json && astro build --config .config/astro.config.ts",
    "preview": "astro preview",
    "format": "prettier --config .config/.prettierrc --ignore-path .config/.prettierignore --write \"templates/**/*.{astro,css,js,ts}\" \"dist/**/*.{html,js}\"",
    "check": "astro check --config .config/astro.config.ts"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@mlc-ai/web-llm": "^0.2.88",
    "astro": "^7.4.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "hastscript": "^9.0.3",
    "unist-util-visit": "^5.2.0"
  }
}
